<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="seL4" fetch="https://github.com/seL4"/>
  <remote name="dw" fetch="https://github.com/dornerworks"/>

  <default remote="dw" revision="dw/main"/>

  <project name="musllibc"    path="projects/musllibc"    remote="seL4" revision="master"/>
  <project name="sel4runtime" path="projects/sel4runtime" remote="seL4" revision="master"/>

  <project name="seL4"                   path="kernel"                                    />
  <project name="capdl"                  path="projects/capdl"                            />
  <project name="seL4_projects_libs"     path="projects/seL4_projects_libs"               />
  <project name="global-components"      path="projects/global-components"                />
  <project name="camkes-vm-downloader"   path="projects/camkes-vm-images"  revision="main"/>
  <project name="util_libs"              path="projects/util_libs"                        />
  <project name="seL4_libs"              path="projects/seL4_libs"                        />
  <project name="camkes-vm"              path="projects/camkes-vm"                        />
  <project name="camkes-vm-linux"        path="projects/camkes-vm-linux"                  />
  <project name="projects_libs"          path="projects/projects_libs"                    />

  <project name="camkes-vm-apps" path="projects/vm-apps">
    <linkfile dest="easy-settings.cmake" src="easy-settings.cmake"/>
  </project>

  <project name="camkes-tool" path="projects/camkes-tool">
    <linkfile dest="camkes_README.md" src="docs/index.md" />
  </project>

  <project name="seL4_tools" path="tools/seL4">
    <linkfile dest="griddle"       src="cmake-tool/griddle"      />
    <linkfile dest="init-build.sh" src="cmake-tool/init-build.sh"/>
  </project>
</manifest>
